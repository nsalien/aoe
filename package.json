{
  "name": "rijken-van-de-vallei",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-strategiespel voor een kleine groep vrienden, gehost op Cloudflare Pages + D1.",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:init:local": "wrangler d1 migrations apply rijken-db --local",
    "db:init:remote": "wrangler d1 migrations apply rijken-db --remote",
    "deploy": "bash scripts/deploy.sh",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.150.0"
  }
}
